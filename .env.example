# ==============================================================================
# AI-Powered Website Link Analysis API — Environment Configuration
# Copy this file to .env and fill in at least one LLM provider API key.
# Never commit your real .env file to version control.
# ==============================================================================

# Primary LLM provider: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini

# Optional fallback provider used if the primary provider fails or hits rate limits
# Set to empty string to disable fallback.
LLM_FALLBACK_PROVIDER=openai

# --- Google Gemini (Active non-deprecated default) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI (Active non-deprecated fallback) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# --- Anthropic Claude (Active non-deprecated optional) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Server Settings ---
APP_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=INFO

# --- Website Extraction & Cost Optimization ---
REQUEST_TIMEOUT_SECONDS=15.0
LLM_TIMEOUT_SECONDS=60.0
MAX_HTML_BYTES=2097152
MAX_EXTRACTED_CHARS=12000
ENABLE_SUBPAGE_CRAWL=true
MAX_SUBPAGES=2

# --- Caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
